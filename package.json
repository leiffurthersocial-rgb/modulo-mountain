{
  "name": "modulo-mountain",
  "private": true,
  "version": "0.0.1",
  "description": "Modulo: Mountain - real-scale 3D mountain simulator for the browser",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "e2e:update": "playwright test --trace off --update-snapshots",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "fetch-dem": "tsx scripts/fetch-dem.ts",
    "build-tiles": "/usr/bin/env python3.12 scripts/pipeline/build_tiles.py"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
